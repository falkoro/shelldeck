[Unit]
Description=Deploy ShellDeck from origin/master when it changes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/repos/shelldeck
Environment=PATH=%h/.bun/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/repos/shelldeck/scripts/watch-deploy-host.sh
