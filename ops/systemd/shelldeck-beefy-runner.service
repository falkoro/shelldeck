[Unit]
Description=GitHub Actions runner on logan-gl502vs for ShellDeck beefy deploy (shelldeck-beefy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runners/shelldeck-beefy
Environment=PATH=%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/actions-runners/shelldeck-beefy/run.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target