[Unit]
Description=GitHub Actions runner for ShellDeck host deploy (shelldeck-host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runners/shelldeck-host
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/actions-runners/shelldeck-host/run.sh
Restart=always
RestartSec=10
TimeoutStartSec=2min

[Install]
WantedBy=default.target