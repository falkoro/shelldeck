#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/shelldeck-secret [--env-file FILE | --dir DIR] KEY [--generate | --prompt | --stdin]

Examples:
  scripts/shelldeck-secret --dir ~/.config/shelldeck DASHBOARD_SECRET --generate
  scripts/shelldeck-secret --env-file ~/.config/shelldeck/shelldeck.env DASHBOARD_PASSWORD --prompt
  printf '%s\n' "$XAI_API_KEY" | scripts/shelldeck-secret --dir ~/.config/shelldeck XAI_API_KEY --stdin

Creates the parent folder, writes KEY into the env file, and locks the file to 0600.
The secret value is never printed.
EOF
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

env_file=".env"
mode="prompt"
key=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --env-file)
      [ "$#" -ge 2 ] || die "--env-file needs a path"
      env_file="$2"
      shift 2
      ;;
    --dir)
      [ "$#" -ge 2 ] || die "--dir needs a folder"
      env_file="${2%/}/.env"
      shift 2
      ;;
    --generate)
      mode="generate"
      shift
      ;;
    --prompt)
      mode="prompt"
      shift
      ;;
    --stdin)
      mode="stdin"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [ -z "$key" ] || die "only one KEY can be updated per run"
      key="$1"
      shift
      ;;
  esac
done

[ -n "$key" ] || { usage; exit 2; }
[[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "KEY must be a valid environment variable name"

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 48 | tr -d '\n'
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(48), end="")
PY
    return
  fi
  LC_ALL=C tr -dc 'A-Za-z0-9_-' </dev/urandom | head -c 64
}

case "$mode" in
  generate)
    value="$(generate_secret)"
    ;;
  stdin)
    IFS= read -r value || true
    [ -n "${value:-}" ] || die "no secret received on stdin"
    ;;
  prompt)
    printf 'Value for %s: ' "$key" >&2
    stty -echo
    IFS= read -r value || true
    stty echo
    printf '\n' >&2
    [ -n "${value:-}" ] || die "empty secret refused"
    ;;
  *)
    die "unknown mode: $mode"
    ;;
esac

parent="$(dirname "$env_file")"
base="$(basename "$env_file")"
mkdir -p "$parent"
umask 077
[ -f "$env_file" ] || : >"$env_file"
chmod 600 "$env_file"

quote_env() {
  local raw="$1"
  raw="${raw//\\/\\\\}"
  raw="${raw//\"/\\\"}"
  raw="${raw//\$/\\\$}"
  raw="${raw//\`/\\\`}"
  printf '"%s"' "$raw"
}

line="${key}=$(quote_env "$value")"
tmp="$(mktemp "${parent}/.${base}.tmp.XXXXXX")"
chmod 600 "$tmp"

awk -v key="$key" -v line="$line" '
  BEGIN { done = 0 }
  /^[[:space:]]*#/ { print; next }
  $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
    if (!done) {
      print line
      done = 1
    }
    next
  }
  { print }
  END {
    if (!done) print line
  }
' "$env_file" >"$tmp"

mv "$tmp" "$env_file"
chmod 600 "$env_file"
printf 'Updated %s in %s (0600)\n' "$key" "$env_file"
